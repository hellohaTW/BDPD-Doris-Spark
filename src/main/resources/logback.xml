<?xml version="1.0" encoding="UTF-8"?>
<!--
  Console logging for local/in-JVM runs. On a real cluster, Spark's log4j2 binds instead.
  Structured logging (Task 5) is done in the message itself: metrics and lifecycle events are
  emitted as single-line JSON (see com.yourteam.ingestion.metrics), so they survive whichever
  backend binds. This pattern just frames each line with a timestamp/level for humans.
-->
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Spark/Kafka are noisy at INFO; keep them at WARN so our output is readable -->
    <logger name="org.apache.spark" level="WARN"/>
    <logger name="org.apache.kafka" level="WARN"/>
    <logger name="org.spark_project" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
